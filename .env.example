# Drizzle
# DATABASE_DIALECT selects the database backend: "sqlite" (default, no extra
# infrastructure needed) or "postgresql" (better suited for larger setups).
DATABASE_DIALECT="sqlite"

# For DATABASE_DIALECT=sqlite, DATABASE_URL is a filesystem path to the
# database file (created automatically if it doesn't exist yet):
DATABASE_URL="./data/wiki.db"

# For DATABASE_DIALECT=postgresql, DATABASE_URL is a connection string.
# Matches the credentials in compose.yaml:
# DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# AUTH_MODE controls what's accessible without logging in:
#   disabled  - everyone can read and write, no login needed
#   read-only - (default) everyone can read, editing/creating needs login
#   full      - no access at all without login (private wiki)
AUTH_MODE="read-only"

# ALLOW_SIGNUP controls who can create an account:
#   (unset)   - (default) only the first account; afterwards registration is closed
#   true      - anyone can register
#   false     - nobody can register
# ALLOW_SIGNUP=""

# Largest request body the server accepts. Without it, adapter-node's default
# of 512K refuses most file uploads (they may be up to 10 MB). The Docker
# image sets this already.
BODY_SIZE_LIMIT="11M"

# MCP_TOKEN switches on the MCP endpoint (/mcp) that connects AI assistants
# like ChatGPT or Claude to the wiki. Unset, the endpoint doesn't exist.
# Use a long random value, e.g. `openssl rand -hex 32`. Clients send it as
# `Authorization: Bearer <token>`, or — where they can't set headers, like
# ChatGPT — as part of the address: https://wiki.example.org/mcp/<token>
# MCP_TOKEN=""
