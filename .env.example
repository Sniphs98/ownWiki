# Drizzle
# DATABASE_DIALECT selects the database backend: "sqlite" (default, no extra
# infrastructure needed) or "postgresql" (better suited for larger setups).
DATABASE_DIALECT="sqlite"

# For DATABASE_DIALECT=sqlite, DATABASE_URL is a filesystem path to the
# database file (created automatically if it doesn't exist yet):
DATABASE_URL="./data/wiki.db"

# For DATABASE_DIALECT=postgresql, DATABASE_URL is a connection string.
# Matches the credentials in compose.yaml:
# DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# AUTH_MODE controls what's accessible without logging in:
#   disabled  - everyone can read and write, no login needed
#   read-only - (default) everyone can read, editing/creating needs login
#   full      - no access at all without login (private wiki)
AUTH_MODE="read-only"

# ALLOW_SIGNUP controls who can create an account:
#   (unset)   - (default) only the first account; afterwards registration is closed
#   true      - anyone can register
#   false     - nobody can register
# ALLOW_SIGNUP=""

# Log in with Microsoft (Entra ID), for your company's tenant. All three
# switch it on; see "Anmeldung mit Microsoft" in the README for the app
# registration. Microsoft logins may always create an account; ALLOW_SIGNUP
# only governs email and password.
# MICROSOFT_CLIENT_ID=""
# MICROSOFT_CLIENT_SECRET=""
# MICROSOFT_TENANT_ID=""
# PASSWORD_LOGIN=false turns email and password off: Microsoft only — or,
# without Microsoft and with AUTH_MODE=disabled, no login at all.
# PASSWORD_LOGIN=""

# Behind a reverse proxy under a path, e.g. https://example.org/wiki: the path.
# Set at start; ORIGIN stays the address without it. See "Behind a reverse
# proxy" in the README (Traefik example included).
# BASE_PATH="/wiki"
# The visitors' real addresses, for the login rate limit (one proxy in front):
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1"

# Largest request body the server accepts. Without it, adapter-node's default
# of 512K refuses most file uploads (they may be up to 10 MB). The Docker
# image sets this already.
BODY_SIZE_LIMIT="11M"

# Semantic search (optional): any service with OpenAI's embeddings API.
# Without it, the search finds pages by their words only.
#   OpenAI:  https://api.openai.com/v1 with text-embedding-3-small
#   Azure:   https://<resource>.openai.azure.com/openai/v1 with your deployment
#   Ollama:  http://ollama:11434/v1 with bge-m3 — runs on your own server, no
#            key, no GPU: docker compose --profile ollama up -d (compose.yaml).
#            Without Docker: http://localhost:11434/v1
# EMBEDDINGS_URL=""
# EMBEDDINGS_MODEL=""
# EMBEDDINGS_API_KEY=""
# Optional: shorter vectors (text-embedding-3-* only) and the similarity a
# page needs to count as a hit (default 0.3, fits text-embedding-3-*; use 0.5
# for bge-m3; for other models raise it if too much unrelated is found).
# EMBEDDINGS_DIMENSIONS=""
# EMBEDDINGS_MIN_SCORE=""
