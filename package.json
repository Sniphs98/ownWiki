{
	"name": "ownwiki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "npm run auth:schema:pg && npm run auth:schema:sqlite",
		"auth:schema:pg": "cross-env DATABASE_DIALECT=postgresql DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.pg.ts --yes",
		"auth:schema:sqlite": "cross-env DATABASE_DIALECT=sqlite DATABASE_URL=./.data/auth-schema-gen.sqlite auth generate --config src/lib/server/auth.ts --output src/lib/server/db/schema/auth.sqlite.ts --yes"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/fira-code": "^5.3.0",
		"@fontsource-variable/gelasio": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"auth": "^1.6.23",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/view": "^6.43.13",
		"@excalidraw/excalidraw": "^0.18.1",
		"@internationalized/date": "^3.12.4",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.40.0",
		"@milkdown/crepe": "7.22.1",
		"@milkdown/kit": "7.22.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"better-auth": "^1.6.23",
		"better-sqlite3": "^12.11.1",
		"bits-ui": "^2.19.0",
		"bpmn-js": "^18.31.0",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"mermaid": "^12.1.0",
		"pagedjs": "^0.4.3",
		"playwright": "^1.62.1",
		"postgres": "^3.4.9",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"svelte": "^5.56.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true
	}
}
